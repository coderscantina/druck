{
  "version": 1,
  "document": {
    "numbered-headings": false
  },
  "tokens": {
    "colors": {
      "accent": "#7a2a2a",
      "muted": "#6b5f57"
    }
  },
  "page": {
    "margins": {
      "top": "25mm",
      "bottom": "28mm",
      "inner": "28mm",
      "outer": "28mm"
    },
    "footer-offset": "12mm"
  },
  "styles": {
    "heading-2": {
      "color": "$colors.accent"
    },
    "title": {
      "color": "$colors.accent",
      "align": "left"
    },
    "subtitle": {
      "align": "left"
    },
    "author": {
      "align": "left",
      "size": "$sizes.body"
    },
    "caption": {
      "style": "italic"
    }
  }
}
