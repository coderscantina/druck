{
  "version": 1,
  "document": {
    "numbering-depth": 2,
    "citation-style": "numeric"
  },
  "tokens": { "sizes": { "body": "9pt" } },
  "page": {
    "margins": {
      "top": "22mm",
      "bottom": "25mm",
      "inner": "18mm",
      "outer": "18mm",
      "mirror": false
    },
    "column-gap": "6mm",
    "footer-offset": "12mm"
  },
  "styles": {
    "body": { "line-height": 1.3 },
    "title": { "size": "18pt" },
    "author": { "size": "11pt" },
    "heading-1": { "size": "1.15em", "space-before": "1.2em", "space-after": "0.4em" },
    "heading-2": { "size": "1em", "style": "italic", "weight": "regular", "space-before": "0.9em", "space-after": "0.3em" },
    "caption": { "size": "0.9em" }
  },
  "typesetting": { "hyphen-fragments": [2, 2] },
  "title-block": {
    "slots": [
      { "text": "{title}", "style": "title", "required": true },
      { "text": "{subtitle}", "style": "subtitle", "space-before": "0.4em" },
      { "text": "{author}", "style": "author", "required": true, "space-before": "1.2em" },
      { "text": "{date}", "style": "date", "space-before": "0.3em" },
      { "text": "{abstract}", "style": "abstract", "space-before": "1.6em" }
    ],
    "space-after": "1.6em"
  }
}
