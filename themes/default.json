      "background": "$colors.callout-light",
      "rule": { "thickness": "4pt", "color": "$colors.text" }
    }
  },
  "footnotes": {
    "gap": "1em",
    "separator-width": "5em",
    "separator-thickness": "$spacing.hairline",
    "separator-color": "$colors.rule",
    "spacing": "0.3em"
  },
  "margin-notes": {
    "width": "20mm",
    "gap": "3mm",
    "spacing": "0.5em",
    "style": "footnote",
    "align": "left",
    "sidenotes": false
  },
  "captions": {
    "separator": ": "
  },
  "placement": {
    "figure": "here",
    "table": "here"
  },
  "bibliography": {
    "hanging-indent": "1.5em",
    "entry-spacing": "0.4em"
  },
  "toc": {
    "level-indent": "1.5em",
    "leader": true,
    "level-styles": []
  },
  "index": {
    "columns": 2,
    "level-indent": "1em",
    "hanging-indent": "2em",
    "separator": ", "
  },
  "matter": {
    "front": { "page-numbers": "lower-roman", "restart": true },
    "main": { "page-numbers": "decimal", "restart": true },
    "back": { "page-numbers": "decimal", "restart": false }
  },
  "chapters": {
    "break-before": "none",
    "sink": "0pt",
    "number-format": "decimal",
    "number-position": "inline",
    "number-style": "heading-1",
    "number-label": false,
    "ornament": null,
    "drop-cap": 0,
    "lead-in": 0
  },
  "typesetting": {
    "heading-lines": 3,
    "hyphens-in-a-row": 2,
    "chapter-last-lines": 5,
    "hyphen-fragments": null,
    "no-break-spaces": true
  },
  "scene-break": {
    "text": "* * *",
    "image": null,
    "width": null,
    "blank": false
  },
  "title-block": {
    "slots": [
      {
        "text": "{title}",
        "style": "title",
        "required": true,
        "space-before": "0pt"
      },
      {
        "text": "{subtitle}",
        "style": "subtitle",
        "required": false,
        "space-before": "0.4em"
      },
      {
        "text": "{author}",
        "style": "author",
        "required": false,
        "space-before": "0.8em"
      },
      {
        "text": "{date}",
        "style": "date",
        "required": false,
        "space-before": "0.3em"
      },
      {
        "text": "{abstract}",
        "style": "abstract",
        "required": false,
        "space-before": "1.5em"
      }
    ],
    "space-after": "2em"
  },
  "title-page": {
    "groups": [
      {
        "anchor": "top-left",
        "slots": [
          {
            "text": "{title}",
            "style": "title",
            "required": true,
            "space-before": "8em"
          },
          {
            "text": "{subtitle}",
            "style": "subtitle",
            "required": false,
            "space-before": "1em"
          },
          {
            "text": "{author}",
            "style": "author",
            "required": false,
            "space-before": "5em"
          },
          {
            "text": "{date}",
            "style": "date",
            "required": false,
            "space-before": "1.5em"
          },
          {
            "text": "{abstract}",
            "style": "abstract",
            "required": false,
            "space-before": "5em"
          }
        ]
      }
    ]
  },
  "pages": {
    "title": {
      "header": null,
      "footer": null
    },
    "first": {
      "header": null,
      "footer": [
        {
          "anchor": "top-left",
          "align": "center",
          "slots": [{ "text": "{page}", "required": false }]
        }
      ]
    },
    "opening": null,
    "odd": null,
    "even": null,
    "body": {
      "header": [
        {
          "anchor": "bottom-left",
          "align": "left",
          "slots": [{ "text": "{section}", "required": false }]
        }
      ],
      "footer": [
        {
          "anchor": "top-left",
          "align": "center",
          "slots": [{ "text": "{page}", "required": false }]
        }
      ]
    }
  },
  "watermark": {
    "text": "{draft}",
    "angle": 45
  },
  "highlight": {
    "comment": "$colors.muted",
    "keyword": "$colors.accent",
    "string": "#2d6a4f",
    "number": "#8a4b08",
    "constant": "#8a4b08",
    "type": "#1b6b73",
    "function": "#5a3d8a",
    "operator": "$colors.text",
    "punctuation": "$colors.text",
    "tag": "$colors.accent",
    "attribute": "#1b6b73"
  },
  "labels": {
    "en": {
      "figure": "Figure",
      "table": "Table",
      "section": "Section",
      "page": "page",
      "contents": "Contents",
      "abstract": "Abstract",
      "references": "References",
      "continued": "(continued)",
      "draft": "Draft",
      "chapter": "Chapter",
      "note": "Note",
      "tip": "Tip",
      "important": "Important",
      "warning": "Warning",
      "caution": "Caution",
      "index": "Index",
      "see": "see",
      "see-also": "see also",
      "symbols": "Symbols"
    },
    "de": {
      "figure": "Abbildung",
      "table": "Tabelle",
      "section": "Abschnitt",
      "page": "Seite",
      "contents": "Inhalt",
      "abstract": "Zusammenfassung",
      "references": "Literatur",
      "continued": "(Fortsetzung)",
      "draft": "Entwurf",
      "chapter": "Kapitel",
      "note": "Hinweis",
      "tip": "Tipp",
      "important": "Wichtig",
      "warning": "Warnung",
      "caution": "Vorsicht",
      "index": "Register",
      "see": "siehe",
      "see-also": "siehe auch",
      "symbols": "Symbole"
    }
  }
}
