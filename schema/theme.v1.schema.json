              "$ref": "#/$defs/band"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Header and footer of one page variant."
    },
    "titleSlot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "description": "Slot text. Use either text or image.",
          "$ref": "#/$defs/template"
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "description": "Name of an entry in the images map. Needs width."
        },
        "width": {
          "description": "Image width. Required for image slots, not allowed for text slots. em is relative to the slot style size.",
          "$ref": "#/$defs/spacingSpec"
        },
        "style": {
          "description": "Block style for the slot. Defaults to body.",
          "$ref": "#/$defs/templateStyle"
        },
        "required": {
          "type": "boolean",
          "description": "Whether the slot must be non-empty. Defaults to false."
        },
        "space-before": {
          "description": "Space above the slot. em is relative to the slot style size. Defaults to 0pt.",
          "$ref": "#/$defs/spacingSpec"
        }
      },
      "description": "One title slot: text or an image."
    },
    "titleBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/titleSlot"
          },
          "description": "Ordered slots. The list is replaced as a whole when a theme sets it."
        },
        "space-after": {
          "description": "Space between the title block and the body. em is relative to the body size.",
          "$ref": "#/$defs/spacingSpec"
        }
      },
      "description": "Ordered content slots and the space below them."
    },
    "titleLayout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/titleGroup"
          },
          "description": "Anchored slot groups. The list is replaced as a whole when a theme sets it."
        }
      },
      "description": "Anchored slot groups."
    },
    "labelSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "figure": {
          "type": "string",
          "description": "Label for figures."
        },
        "table": {
          "type": "string",
          "description": "Label for tables."
        },
        "section": {
          "type": "string",
          "description": "Label for references to numbered headings, as in \"Section 2.1\"."
        },
        "page": {
          "type": "string",
          "description": "Label for page references, as in \"page 5\"."
        },
        "contents": {
          "type": "string",
          "description": "Table of contents heading."
        },
        "abstract": {
          "type": "string",
          "description": "Abstract heading."
        },
        "references": {
          "type": "string",
          "description": "Bibliography heading."
        },
        "continued": {
          "type": "string",
          "description": "Marker for a table continued on the next page."
        }
      },
      "description": "Generated text for one language."
    }
