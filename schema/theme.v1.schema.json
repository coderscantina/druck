{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kyber.invalid/schema/theme.v1.schema.json",
  "title": "Kyber theme, version 1",
  "description": "A kyber theme file. Files may be partial: only version is required, other fields inherit from the bundled default.",
  "type": "object",
  "required": [
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Schema location for editors. Ignored by kyber."
    },
    "version": {
      "const": 1,
      "description": "Theme format version. Required."
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lang": {
          "enum": [
            "en",
            "de"
          ],
          "description": "Default document language."
        },
        "title-page": {
          "type": "boolean",
          "description": "Whether to render a separate title page."
        },
        "toc": {
          "type": "boolean",
          "description": "Whether to render a table of contents."
        },
        "duplex": {
          "type": "boolean",
          "description": "Whether the body starts on an odd page, with a blank page after the title page and the table of contents where needed."
        },
        "numbered-headings": {
          "type": "boolean",
          "description": "Whether headings are numbered."
        },
        "numbering-depth": {
          "description": "Deepest heading level that is numbered.",
          "$ref": "#/$defs/headingDepth"
        },
        "toc-depth": {
          "description": "Deepest heading level listed in the table of contents.",
          "$ref": "#/$defs/headingDepth"
        },
        "citation-style": {
          "enum": [
            "author-date",
            "numeric"
          ],
          "description": "Citation style."
        }
      },
      "description": "Document defaults. Front matter and CLI options may override them."
    },
    "fonts": {
      "type": "object",
      "description": "Font families by name. Styles refer to these names.",
      "additionalProperties": {
        "$ref": "#/$defs/fontFamily"
      }
    },
    "images": {
      "type": "object",
      "description": "Images by name, for use in title slots.",
      "additionalProperties": {
        "$ref": "#/$defs/resourcePath"
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fonts": {
          "type": "object",
          "description": "Font family tokens.",
          "additionalProperties": {
            "$ref": "#/$defs/fontSpec"
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9-]+$"
          }
        },
        "sizes": {
          "type": "object",
          "description": "Font size tokens.",
          "additionalProperties": {
            "$ref": "#/$defs/sizeSpec"
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9-]+$"
          }
        },
        "spacing": {
          "type": "object",
          "description": "Spacing tokens.",
          "additionalProperties": {
            "$ref": "#/$defs/spacingSpec"
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9-]+$"
          }
        },
        "colors": {
          "type": "object",
          "description": "Color tokens.",
          "additionalProperties": {
            "$ref": "#/$defs/colorSpec"
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9-]+$"
          }
        }
      },
      "description": "Named values. Tokens may reference other tokens of the same group."
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "description": "A paper size or a custom width and height.",
          "anyOf": [
            {
              "enum": [
                "a4",
                "a5",
                "b5",
                "letter",
                "legal"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["width", "height"],
              "properties": {
                "width": {
                  "description": "Page width. em is relative to the body size.",
                  "$ref": "#/$defs/spacingSpec"
                },
                "height": {
                  "description": "Page height. em is relative to the body size.",
                  "$ref": "#/$defs/spacingSpec"
                }
              }
            }
          ]
        },
        "margins": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "top": {
              "description": "Top margin. em is relative to the body size.",
              "$ref": "#/$defs/spacingSpec"
            },
            "bottom": {
              "description": "Bottom margin. em is relative to the body size.",
              "$ref": "#/$defs/spacingSpec"
            },
            "inner": {
              "description": "Inner margin. Left on odd pages, and right on even pages if margins mirror. em is relative to the body size.",
              "$ref": "#/$defs/spacingSpec"
            },
            "outer": {
              "description": "Outer margin. em is relative to the body size.",
              "$ref": "#/$defs/spacingSpec"
            },
            "mirror": {
              "type": "boolean",
              "description": "Whether even pages put the inner margin on the right. With false, inner is the left margin on every page."
            }
          }
        },
        "text-width": {
          "description": "Width of prose, from the inner edge of the margin frame, or null for the frame width. em is relative to the body size.",
          "anyOf": [
            {
              "$ref": "#/$defs/spacingSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "wide": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "table",
              "figure",
              "code-block"
            ]
          },
          "description": "Block kinds set across the whole margin frame when text-width is narrower. Inside lists, quotations, and columns they keep the width they are in."
        },
        "column-gap": {
          "description": "Gap between columns. em is relative to the body size.",
          "$ref": "#/$defs/spacingSpec"
        },
        "column-change-spacing": {
          "description": "Least space between a column section and the full-width blocks above and below it, or null for the column gap. em is relative to the body size.",
          "anyOf": [
            {
              "$ref": "#/$defs/spacingSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "header-offset": {
          "description": "Distance from the top of the text area to the header baseline. em is relative to the body size.",
          "$ref": "#/$defs/spacingSpec"
        },
        "footer-offset": {
          "description": "Distance from the bottom of the text area to the footer baseline. em is relative to the body size.",
          "$ref": "#/$defs/spacingSpec"
        }
      },
      "description": "Page geometry."
    },
    "styles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "body": {
          "description": "Running text.",
          "$ref": "#/$defs/blockStyle"
        },
        "heading-1": {
          "description": "Level 1 headings.",
          "$ref": "#/$defs/headingStyle"
        },
        "heading-2": {
          "description": "Level 2 headings.",
          "$ref": "#/$defs/headingStyle"
        },
        "heading-3": {
          "description": "Level 3 headings.",
          "$ref": "#/$defs/headingStyle"
        },
        "heading-4": {
          "description": "Level 4 headings.",
          "$ref": "#/$defs/headingStyle"
        },
        "heading-5": {
          "description": "Level 5 headings.",
          "$ref": "#/$defs/headingStyle"
        },
        "heading-6": {
          "description": "Level 6 headings.",
          "$ref": "#/$defs/headingStyle"
        },
        "title": {
          "description": "Document title.",
          "$ref": "#/$defs/blockStyle"
        },
        "subtitle": {
          "description": "Document subtitle.",
          "$ref": "#/$defs/blockStyle"
        },
        "author": {
          "description": "Author line.",
          "$ref": "#/$defs/blockStyle"
        },
        "date": {
          "description": "Date line.",
          "$ref": "#/$defs/blockStyle"
        },
        "abstract-heading": {
          "description": "Heading above the abstract.",
          "$ref": "#/$defs/blockStyle"
        },
        "abstract": {
          "description": "Abstract text.",
          "$ref": "#/$defs/blockStyle"
        },
        "quote": {
          "description": "Block quotations.",
          "$ref": "#/$defs/blockStyle"
        },
        "list": {
          "description": "List items.",
          "$ref": "#/$defs/blockStyle"
        },
        "code-block": {
          "description": "Fenced and indented code.",
          "$ref": "#/$defs/blockStyle"
        },
        "caption": {
          "description": "Figure and table captions.",
          "$ref": "#/$defs/blockStyle"
        },
        "table-cell": {
          "description": "Table body cells.",
          "$ref": "#/$defs/blockStyle"
        },
        "table-header": {
          "description": "Table header cells.",
          "$ref": "#/$defs/blockStyle"
        },
        "footnote": {
          "description": "Footnote text.",
          "$ref": "#/$defs/blockStyle"
        },
        "bibliography": {
          "description": "Bibliography entries.",
          "$ref": "#/$defs/blockStyle"
        },
        "toc-heading": {
          "description": "Table of contents heading.",
          "$ref": "#/$defs/blockStyle"
        },
        "toc-entry": {
          "description": "Table of contents entries.",
          "$ref": "#/$defs/blockStyle"
        },
        "header": {
          "description": "Running header text.",
          "$ref": "#/$defs/blockStyle"
        },
        "footer": {
          "description": "Running footer text.",
          "$ref": "#/$defs/blockStyle"
        }
      },
      "description": "Block element styles."
    },
    "custom-styles": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/customStyle"
      },
      "description": "Named styles that documents apply with {.name}, each based on another style."
    },
    "inline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "font": {
              "description": "Font family.",
              "$ref": "#/$defs/fontSpec"
            },
            "size": {
              "description": "Font size. em is relative to the surrounding text.",
              "$ref": "#/$defs/sizeSpec"
            },
            "color": {
              "description": "Text color.",
              "$ref": "#/$defs/colorSpec"
            }
          },
          "description": "Inline code."
        },
        "link": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": {
              "description": "Link color.",
              "$ref": "#/$defs/colorSpec"
            },
            "underline": {
              "type": "boolean",
              "description": "Whether links are underlined."
            }
          },
          "description": "Links."
        },
        "footnote-marker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "description": "Marker size. em is relative to the surrounding text.",
              "$ref": "#/$defs/sizeSpec"
            },
            "raise": {
              "description": "Baseline shift. em is relative to the surrounding text.",
              "$ref": "#/$defs/spacingSpec"
            }
          },
          "description": "Footnote reference marks."
        }
      },
      "description": "Inline styles."
    },
    "lists": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "indent": {
          "description": "Indent per nesting level. em is relative to the list style size.",
          "$ref": "#/$defs/spacingSpec"
        },
        "item-spacing": {
          "description": "Space between items. em is relative to the list style size.",
          "$ref": "#/$defs/spacingSpec"
        },
        "bullets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Bullet per nesting level. Deeper levels repeat the last entry."
        },
        "marker": {
          "description": "A built-in or custom style whose font, size, weight, and color set bullets and numbers, or null for the list style.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "List layout."
    },
    "tables": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cell-padding": {
          "description": "Padding inside cells. em is relative to the table cell style size.",
          "$ref": "#/$defs/spacingSpec"
        },
        "top-rule": {
          "description": "Rule above the header row, or null for none.",
          "anyOf": [
            {
              "$ref": "#/$defs/tableRule"
            },
            {
              "type": "null"
            }
          ]
        },
        "header-rule": {
          "description": "Rule below the header row, or null for none.",
          "anyOf": [
            {
              "$ref": "#/$defs/tableRule"
            },
            {
              "type": "null"
            }
          ]
        },
        "row-rule": {
          "description": "Rule below each body row, or null for none. A row style's rule-below replaces it.",
          "anyOf": [
            {
              "$ref": "#/$defs/tableRule"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Table layout."
    },
    "footnotes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gap": {
          "description": "Minimum space between body text and the separator. em is relative to the footnote style size.",
          "$ref": "#/$defs/spacingSpec"
        },
        "separator-width": {
          "description": "Separator length. em is relative to the footnote style size.",
          "$ref": "#/$defs/spacingSpec"
        },
        "separator-thickness": {
          "description": "Separator thickness. em is relative to the footnote style size.",
          "$ref": "#/$defs/spacingSpec"
        },
        "separator-color": {
          "description": "Separator color.",
          "$ref": "#/$defs/colorSpec"
        },
        "spacing": {
          "description": "Space between footnotes. em is relative to the footnote style size.",
          "$ref": "#/$defs/spacingSpec"
        }
      },
      "description": "Footnote area."
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "separator": {
          "type": "string",
          "description": "Text between the numbered label and the caption, as in \"Figure 1: \"."
        }
      },
      "description": "Captions."
    },
    "bibliography": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hanging-indent": {
          "description": "Indent of continuation lines. em is relative to the bibliography style size.",
          "$ref": "#/$defs/spacingSpec"
        },
        "entry-spacing": {
          "description": "Space between entries. em is relative to the bibliography style size.",
          "$ref": "#/$defs/spacingSpec"
        }
      },
      "description": "Bibliography layout."
    },
    "toc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level-indent": {
          "description": "Indent per heading level. em is relative to the toc entry style size.",
          "$ref": "#/$defs/spacingSpec"
        },
        "leader": {
          "type": "boolean",
          "description": "Whether dot leaders connect entries to page numbers."
        },
        "level-styles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "description": "The built-in or custom style of the entries at each heading level, starting with level 1. The last one repeats for deeper levels. Without any, every entry uses toc-entry."
        }
      },
      "description": "Table of contents layout."
    },
    "title-block": {
      "description": "Title block at the start of the body, set when the document has metadata for it.",
      "$ref": "#/$defs/titleBlock"
    },
    "title-page": {
      "description": "Separate title page.",
      "$ref": "#/$defs/titleLayout"
    },
    "pages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "description": "Title page. null removes the variant.",
          "anyOf": [
            {
              "$ref": "#/$defs/pageVariant"
            },
            {
              "type": "null"
            }
          ]
        },
        "first": {
          "description": "First body page. null removes the variant.",
          "anyOf": [
            {
              "$ref": "#/$defs/pageVariant"
            },
            {
              "type": "null"
            }
          ]
        },
        "odd": {
          "description": "Odd pages. null removes the variant.",
          "anyOf": [
            {
              "$ref": "#/$defs/pageVariant"
            },
            {
              "type": "null"
            }
          ]
        },
        "even": {
          "description": "Even pages. null removes the variant.",
          "anyOf": [
            {
              "$ref": "#/$defs/pageVariant"
            },
            {
              "type": "null"
            }
          ]
        },
        "body": {
          "description": "Fallback for all other pages.",
          "$ref": "#/$defs/pageVariant"
        }
      },
      "description": "Headers and footers per page variant."
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "en": {
          "description": "English labels.",
          "$ref": "#/$defs/labelSet"
        },
        "de": {
          "description": "German labels.",
          "$ref": "#/$defs/labelSet"
        }
      },
      "description": "Generated text per language."
    }
  },
  "$defs": {
    "length": {
      "type": "string",
      "pattern": "^([0-9]+(\\.[0-9]+)?|\\.[0-9]+)(pt|mm|cm|in|em)$",
      "description": "A non-negative length with a unit: pt, mm, cm, in, or em. No percentages."
    },
    "sizesRef": {
      "type": "string",
      "pattern": "^\\$sizes\\.[A-Za-z0-9-]+$",
      "description": "Reference to a token in tokens.sizes, written $sizes.name."
    },
    "spacingRef": {
      "type": "string",
      "pattern": "^\\$spacing\\.[A-Za-z0-9-]+$",
      "description": "Reference to a token in tokens.spacing, written $spacing.name."
    },
    "colorsRef": {
      "type": "string",
      "pattern": "^\\$colors\\.[A-Za-z0-9-]+$",
      "description": "Reference to a token in tokens.colors, written $colors.name."
    },
    "fontsRef": {
      "type": "string",
      "pattern": "^\\$fonts\\.[A-Za-z0-9-]+$",
      "description": "Reference to a token in tokens.fonts, written $fonts.name."
    },
    "sizeSpec": {
      "anyOf": [
        {
          "$ref": "#/$defs/length"
        },
        {
          "$ref": "#/$defs/sizesRef"
        }
      ],
      "description": "A font size: a length or a $sizes token. em is relative to the body size (or the surrounding text for inline styles)."
    },
    "spacingSpec": {
      "anyOf": [
        {
          "$ref": "#/$defs/length"
        },
        {
          "$ref": "#/$defs/spacingRef"
        }
      ],
      "description": "A length or a $spacing token."
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "description": "A color written as #rrggbb."
    },
    "colorSpec": {
      "anyOf": [
        {
          "$ref": "#/$defs/color"
        },
        {
          "$ref": "#/$defs/colorsRef"
        }
      ],
      "description": "A #rrggbb color or a $colors token."
    },
    "fontSpec": {
      "anyOf": [
        {
          "$ref": "#/$defs/fontsRef"
        },
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^$]"
        }
      ],
      "description": "A family name from the fonts map, or a $fonts token."
    },
    "resourcePath": {
      "type": "string",
      "pattern": "\\S",
      "not": {
        "pattern": "://"
      },
      "description": "A local file path, relative to the file that contains it. Remote URLs are not allowed."
    },
    "template": {
      "type": "string",
      "description": "Text with placeholders {title}, {subtitle}, {author}, {date}, {abstract}, {section}, {subsection}, {page}, {pages}, and {meta.key} for an entry of the front matter meta map. A line break starts a new line. Write {{ and }} for literal braces."
    },
    "headingDepth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6,
      "description": "A heading level from 1 to 6."
    },
    "lineHeight": {
      "type": "number",
      "minimum": 0.8,
      "maximum": 3.0,
      "description": "Unitless multiple of the element font size, from 0.8 to 3."
    },
    "templateStyle": {
      "anyOf": [
        {
          "enum": [
            "title",
            "subtitle",
            "author",
            "date",
            "abstract-heading",
            "abstract",
            "body"
          ]
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      ],
      "description": "The style a slot is set in: a built-in slot style or the name of a custom style."
    },
    "tableRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "thickness": {
          "description": "Rule thickness. em is relative to the table cell style size.",
          "$ref": "#/$defs/spacingSpec"
        },
        "color": {
          "description": "Rule color.",
          "$ref": "#/$defs/colorSpec"
        }
      },
      "description": "A rule across a table."
    },
    "weight": {
      "anyOf": [
        {
          "enum": [
            "regular",
            "bold"
          ]
        },
        {
          "type": "integer",
          "minimum": 100,
          "maximum": 900,
          "multipleOf": 100
        }
      ],
      "description": "Font weight from 100 to 900 in steps of 100. regular is 400 and bold is 700."
    },
    "fontFile": {
      "anyOf": [
        {
          "$ref": "#/$defs/resourcePath"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "index"
          ],
          "properties": {
            "file": {
              "description": "A font collection file (.ttc, .otc).",
              "$ref": "#/$defs/resourcePath"
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "description": "The index of the face in the collection, from 0."
            }
          }
        }
      ],
      "description": "A font file, or a face of a collection by its index."
    },
    "fontFace": {
      "anyOf": [
        {
          "$ref": "#/$defs/fontFile"
        },
        {
          "type": "null"
        }
      ],
      "description": "A face file, or null if the family has no such face."
    },
    "fontFamily": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "regular": {
          "description": "Regular face file, weight 400.",
          "$ref": "#/$defs/fontFile"
        },
        "italic": {
          "description": "Italic face file, weight 400, or null if the family has none.",
          "$ref": "#/$defs/fontFace"
        },
        "bold": {
          "description": "Bold face file, weight 700, or null if the family has none.",
          "$ref": "#/$defs/fontFace"
        },
        "bold-italic": {
          "description": "Bold italic face file, weight 700, or null if the family has none.",
          "$ref": "#/$defs/fontFace"
        }
      },
      "patternProperties": {
        "^[1235689]00(-italic)?$": {
          "description": "The face of another weight, upright or italic, such as 500 or 300-italic.",
          "$ref": "#/$defs/fontFace"
        }
      },
      "description": "Font files for one family by face. Styles may only request faces that are present."
    },
    "blockStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "font": {
          "description": "Font family.",
          "$ref": "#/$defs/fontSpec"
        },
        "size": {
          "description": "Font size. em is relative to the body size.",
          "$ref": "#/$defs/sizeSpec"
        },
        "weight": {
          "$ref": "#/$defs/weight"
        },
        "style": {
          "enum": [
            "normal",
            "italic"
          ],
          "description": "Font style."
        },
        "color": {
          "description": "Text color.",
          "$ref": "#/$defs/colorSpec"
        },
        "line-height": {
          "description": "Line height as a multiple of this element's font size.",
          "$ref": "#/$defs/lineHeight"
        },
        "align": {
          "enum": [
            "justify",
            "left",
            "center",
            "right"
          ],
          "description": "Text alignment."
        },
        "hyphenate": {
          "type": "boolean",
          "description": "Whether words may be hyphenated."
        },
        "space-before": {
          "description": "Space above the block. em is relative to this element's font size.",
          "$ref": "#/$defs/spacingSpec"
        },
        "space-after": {
          "description": "Space below the block. em is relative to this element's font size.",
          "$ref": "#/$defs/spacingSpec"
        },
        "indent": {
          "description": "Left indent of the whole block. em is relative to this element's font size.",
          "$ref": "#/$defs/spacingSpec"
        },
        "first-line-indent": {
          "description": "Extra indent of each paragraph's first line. em is relative to this element's font size.",
          "$ref": "#/$defs/spacingSpec"
        },
        "tracking": {
          "type": "number",
          "minimum": -0.2,
          "maximum": 1.0,
          "description": "Letter spacing in em of this element's font size, from -0.2 to 1."
        },
        "uppercase": {
          "type": "boolean",
          "description": "Whether text is set in capitals. Inline code keeps its case."
        },
        "keep-with-next": {
          "type": "boolean",
          "description": "Whether the block stays on the page or in the column of the next block."
        }
      },
      "description": "Style of one block element."
    },
    "headingStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "font": {
          "description": "Font family.",
          "$ref": "#/$defs/fontSpec"
        },
        "size": {
          "description": "Font size. em is relative to the body size.",
          "$ref": "#/$defs/sizeSpec"
        },
        "weight": {
          "$ref": "#/$defs/weight"
        },
        "style": {
          "enum": [
            "normal",
            "italic"
          ],
          "description": "Font style."
        },
        "color": {
          "description": "Text color.",
          "$ref": "#/$defs/colorSpec"
        },
        "line-height": {
          "description": "Line height as a multiple of this element's font size.",
          "$ref": "#/$defs/lineHeight"
        },
        "align": {
          "enum": [
            "justify",
            "left",
            "center",
            "right"
          ],
          "description": "Text alignment."
        },
        "hyphenate": {
          "type": "boolean",
          "description": "Whether words may be hyphenated."
        },
        "space-before": {
          "description": "Space above the block. em is relative to this element's font size.",
          "$ref": "#/$defs/spacingSpec"
        },
        "space-after": {
          "description": "Space below the block. em is relative to this element's font size.",
          "$ref": "#/$defs/spacingSpec"
        },
        "indent": {
          "description": "Left indent of the whole block. em is relative to this element's font size.",
          "$ref": "#/$defs/spacingSpec"
        },
        "first-line-indent": {
          "description": "Extra indent of each paragraph's first line. em is relative to this element's font size.",
          "$ref": "#/$defs/spacingSpec"
        },
        "tracking": {
          "type": "number",
          "minimum": -0.2,
          "maximum": 1.0,
          "description": "Letter spacing in em of this element's font size, from -0.2 to 1."
        },
        "uppercase": {
          "type": "boolean",
          "description": "Whether text is set in capitals. Inline code keeps its case."
        },
        "keep-with-next": {
          "type": "boolean",
          "description": "Whether the block stays on the page or in the column of the next block."
        },
        "number-gap": {
          "description": "Space between an automatic heading number and the heading text, which hangs. null sets one space after the number.",
          "anyOf": [
            {
              "$ref": "#/$defs/spacingSpec"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Style of a heading level."
    },
    "customStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "based-on"
      ],
      "properties": {
        "based-on": {
          "type": "string",
          "minLength": 1,
          "description": "A built-in style such as body, heading-2, or list, or another custom style. Fields not given here come from it."
        },
        "font": {
          "$ref": "#/$defs/blockStyle/properties/font"
        },
        "size": {
          "$ref": "#/$defs/blockStyle/properties/size"
        },
        "weight": {
          "$ref": "#/$defs/blockStyle/properties/weight"
        },
        "style": {
          "$ref": "#/$defs/blockStyle/properties/style"
        },
        "color": {
          "$ref": "#/$defs/blockStyle/properties/color"
        },
        "line-height": {
          "$ref": "#/$defs/blockStyle/properties/line-height"
        },
        "align": {
          "$ref": "#/$defs/blockStyle/properties/align"
        },
        "hyphenate": {
          "$ref": "#/$defs/blockStyle/properties/hyphenate"
        },
        "space-before": {
          "$ref": "#/$defs/blockStyle/properties/space-before"
        },
        "space-after": {
          "$ref": "#/$defs/blockStyle/properties/space-after"
        },
        "indent": {
          "$ref": "#/$defs/blockStyle/properties/indent"
        },
        "first-line-indent": {
          "$ref": "#/$defs/blockStyle/properties/first-line-indent"
        },
        "tracking": {
          "$ref": "#/$defs/blockStyle/properties/tracking"
        },
        "uppercase": {
          "$ref": "#/$defs/blockStyle/properties/uppercase"
        },
        "keep-with-next": {
          "$ref": "#/$defs/blockStyle/properties/keep-with-next"
        },
        "bullets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "description": "List markers per nesting level, for styles based on list."
        },
        "marker": {
          "type": "string",
          "description": "A built-in or custom style whose font, size, weight, and color set bullets and numbers, for styles based on list."
        },
        "number-gap": {
          "description": "Space between a number the author typed at the start of a heading, such as 2., and the heading text, which hangs. For styles based on a heading style.",
          "$ref": "#/$defs/spacingSpec"
        },
        "rule-below": {
          "enum": [
            "none",
            "header",
            "row"
          ],
          "description": "The rule below a table row in this style: none, the header rule, or the row rule. For paragraph styles."
        }
      },
      "description": "A named style: another style with the fields given here replaced."
    },
    "anchor": {
      "enum": [
        "top-left",
        "top-right",
        "middle-left",
        "middle-right",
        "bottom-left",
        "bottom-right"
      ],
      "description": "The point of the margin frame a group is placed at: the top, middle, or bottom of its left or right edge. In headers and footers the band baseline takes the place of the frame's top, middle, and bottom."
    },
    "offset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "description": "Distance from the anchored left or right edge into the frame. Defaults to 0pt. em is relative to the body size.",
          "$ref": "#/$defs/spacingSpec"
        },
        "y": {
          "description": "Distance down from a top or middle anchor, or up from a bottom anchor. Defaults to 0pt. em is relative to the body size.",
          "$ref": "#/$defs/spacingSpec"
        }
      },
      "description": "Distance from the anchor into the frame."
    },
    "titleGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor",
        "slots"
      ],
      "properties": {
        "anchor": {
          "$ref": "#/$defs/anchor"
        },
        "offset": {
          "$ref": "#/$defs/offset"
        },
        "width": {
          "description": "Group width. Defaults to the frame width less the horizontal offset. em is relative to the body size.",
          "$ref": "#/$defs/spacingSpec"
        },
        "align": {
          "enum": [
            "justify",
            "left",
            "center",
            "right"
          ],
          "description": "Alignment of the group's lines. Defaults to the alignment of each slot's style."
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/titleSlot"
          },
          "description": "Ordered slots, stacked from the top."
        }
      },
      "description": "Title slots stacked in a box anchored to the margin frame."
    },
    "bandGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor",
        "slots"
      ],
      "properties": {
        "anchor": {
          "$ref": "#/$defs/anchor"
        },
        "offset": {
          "$ref": "#/$defs/offset"
        },
        "width": {
          "description": "Group width. Defaults to the frame width less the horizontal offset. em is relative to the body size.",
          "$ref": "#/$defs/spacingSpec"
        },
        "align": {
          "enum": [
            "justify",
            "left",
            "center",
            "right"
          ],
          "description": "Alignment of the group's lines. Defaults to the alignment of each slot's style."
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bandSlot"
          },
          "description": "Ordered slots, stacked from the top."
        }
      },
      "description": "Header or footer slots stacked at an anchor on the band baseline."
    },
    "bandSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {
          "description": "Slot text, one line per line.",
          "$ref": "#/$defs/template"
        },
        "style": {
          "description": "Block style for the slot. Defaults to the header or footer style.",
          "$ref": "#/$defs/templateStyle"
        },
        "required": {
          "type": "boolean",
          "description": "Whether the slot must be non-empty; an empty required slot is an error."
        },
        "space-before": {
          "description": "Space above the slot. em is relative to the slot style size. Defaults to 0pt.",
          "$ref": "#/$defs/spacingSpec"
        }
      },
      "description": "One header or footer slot."
    },
    "band": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bandGroup"
      },
      "description": "Slot groups of a header or footer. The list is replaced as a whole when a theme sets it."
    },
    "pageVariant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "header": {
          "description": "Header, or null for none.",
